        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    custom_roles {\n        uuid id PK\n        string name UK\n        string description\n        boolean is_system\n    }\n    clinic_branch {\n        uuid id PK\n        string branch_name\n        string address\n        string phone\n        boolean is_active\n        timestamp created_at\n    }\n    users {\n        uuid id PK\n        uuid branch_id FK\n        string username\n        string email\n        string password\n        string role FK\n        string full_name\n        timestamp created_at\n    }\n    doctors {\n        uuid id PK\n        uuid user_id FK\n        uuid branch_id FK\n        string specialization\n        string license_number\n        timestamp created_at\n    }\n    role_permissions {\n        uuid id PK\n        string role_name FK\n        string module\n        boolean can_read\n        boolean can_create\n        boolean can_update\n        boolean can_delete\n    }\n    patients {\n        uuid id PK\n        uuid branch_id FK\n        uuid assigned_doctor_id FK\n        string patient_number\n        string full_name\n        string phone\n        date date_of_birth\n        string gender\n        timestamp created_at\n    }\n    appointments {\n        uuid id PK\n        uuid patient_id FK\n        uuid doctor_id FK\n        uuid branch_id FK\n        uuid created_by FK\n        timestamp appointment_date\n        string status\n        string booking_number\n        timestamp created_at\n    }\n    exam_preliminary {\n        uuid id PK\n        uuid appointment_id FK\n        uuid patient_id FK\n        uuid doctor_id FK\n        string stage\n        text chief_complaint\n        int iop_od\n        int iop_os\n        timestamp created_at\n    }\n    exam_clinical {\n        uuid id PK\n        uuid appointment_id FK\n        uuid preliminary_id FK\n        uuid examined_by FK\n        text diagnosis\n        text management_plan\n        timestamp examined_at\n    }\n    medicine_prescriptions {\n        uuid id PK\n        uuid appointment_id FK\n        uuid clinical_exam_id FK\n        uuid pharmacy_item_id FK\n        string item_name\n        int quantity\n        text instructions\n        string status\n        timestamp created_at\n    }\n    optical_prescriptions {\n        uuid id PK\n        uuid patient_id FK\n        uuid frame_item_id FK\n        uuid lens_item_id FK\n        string od_sphere\n        string os_sphere\n        string status\n        timestamp created_at\n    }\n    pharmacy_items {\n        uuid id PK\n        uuid branch_id FK\n        string item_name\n        string category\n        int stock_quantity\n        decimal selling_price\n        date expiry_date\n    }\n    optical_items {\n        uuid id PK\n        uuid branch_id FK\n        string item_name\n        string item_type\n        int stock_quantity\n        decimal selling_price\n    }\n    billing {\n        uuid id PK\n        uuid patient_id FK\n        uuid appointment_id FK\n        uuid medicine_prescription_id FK\n        uuid optical_prescription_id FK\n        string service_type\n        string item_type\n        int quantity\n        decimal unit_price\n        decimal line_total\n        decimal total_amount\n        decimal final_amount\n        string status\n        string payment_method\n        timestamp created_at\n    }\n\n    custom_roles ||--o{ users : \&quot;assigns role\&quot;\n    custom_roles ||--o{ role_permissions : \&quot;defines permissions\&quot;\n    clinic_branch ||--o{ users : \&quot;employs\&quot;\n    clinic_branch ||--o{ patients : \&quot;registers\&quot;\n    clinic_branch ||--o{ pharmacy_items : \&quot;stocks\&quot;\n    clinic_branch ||--o{ optical_items : \&quot;stocks\&quot;\n    users ||--|| doctors : \&quot;is\&quot;\n    users ||--o{ appointments : \&quot;books\&quot;\n    doctors ||--o{ patients : \&quot;assigns\&quot;\n    doctors ||--o{ appointments : \&quot;attends\&quot;\n    doctors ||--o{ exam_preliminary : \&quot;examines\&quot;\n    doctors ||--o{ exam_clinical : \&quot;examines\&quot;\n    patients ||--o{ appointments : \&quot;requests\&quot;\n    patients ||--o{ exam_preliminary : \&quot;undergoes\&quot;\n    patients ||--o{ optical_prescriptions : \&quot;receives\&quot;\n    patients ||--o{ billing : \&quot;billed\&quot;\n    appointments ||--o| exam_preliminary : \&quot;preliminary\&quot;\n    appointments ||--o| exam_clinical : \&quot;clinical\&quot;\n    appointments ||--o{ medicine_prescriptions : \&quot;prescribes\&quot;\n    appointments ||--o{ billing : \&quot;generates\&quot;\n    exam_preliminary ||--o| exam_clinical : \&quot;proceeds to\&quot;\n    exam_clinical ||--o{ medicine_prescriptions : \&quot;prescribes\&quot;\n    pharmacy_items ||--o{ medicine_prescriptions : \&quot;dispenses\&quot;\n    optical_items ||--o{ optical_prescriptions : \&quot;frame\&quot;\n    optical_items ||--o{ optical_prescriptions : \&quot;lens\&quot;\n    medicine_prescriptions ||--o{ billing : \&quot;charges\&quot;\n    optical_prescriptions ||--o{ billing : \&quot;charges\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pbHGeCxZV6QFuCP1XtXU-483">
