R -[hidden]right- P
P -[hidden]right- B
B -[hidden]down- U
PH -[hidden]right- D
D -[hidden]right- PT
PT -[hidden]right- OI
U -[hidden]down- D
PT -[hidden]down- A
A -[hidden]down- EP
EP -[hidden]right- EC
EC -[hidden]down- MP
MP -[hidden]right- OP
MP -[hidden]down- BL
OP -[hidden]down- BL

R ||--o{ P : configures
R ||--o{ U : assigns
B ||--o{ U : employs
B ||--o{ PT : registers
B ||--o{ PH : stocks
B ||--o{ OI : stocks

U ||--|| D : is_a
U ||--o{ PT : registers
U ||--o{ A : schedules

D ||--o{ PT : cares_for
D ||--o{ A : attends
D ||--o{ EP : performs

PT ||--o{ A : requests
PT ||--o{ OP : receives

A ||--o| EP : preliminary
EP ||--o| EC : clinical

EC ||--o{ MP : prescribes
PH ||--o{ MP : dispenses
OI ||--o{ OP : lens

A ||--o{ BL : bill
MP ||--o{ BL : pharmacy
OP ||--o{ BL : optical
PT ||--o{ BL : pays_for
U ||--o{ BL : processes

@enduml
