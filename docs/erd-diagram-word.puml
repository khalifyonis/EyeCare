@startuml EyeCare_ERD_Word
hide circle
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam nodesep 10
skinparam ranksep 14
skinparam defaultFontSize 7
skinparam dpi 130
skinparam ArrowColor #64748B
skinparam ArrowFontSize 7

skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #C4B5FD
  FontColor #334155
  HeaderBackgroundColor #DDD6FE
  HeaderFontColor #1E293B
}

<style>
entity {
  Padding 4
  RoundCorner 4
}
</style>

title EyeCare Management System — Entity Relationship Diagram

top to bottom direction

entity "roles" as R {
  **type** .. **column** .. **key**
  --
  string .. name ..
  string .. description ..
  timestamp .. created_at ..
  * uuid .. id .. <<PK>>
}

entity "permissions" as P {
  **type** .. **column** .. **key**
  --
  uuid .. role_id .. <<FK>>
  string .. module ..
  boolean .. can_read ..
  boolean .. can_create ..
  boolean .. can_update ..
  boolean .. can_delete ..
  * uuid .. id .. <<PK>>
}

