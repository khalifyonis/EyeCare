{
    "name": "eye-care-root",
    "version": "1.0.0",
    "description": "Root package for Eye Care System",
    "scripts": {
        "start:backend": "npm run dev --prefix backend",
        "start:frontend": "npm run dev --prefix frontend",
        "dev": "node scripts/dev.js",
        "restart": "npm run dev",
        "ports:free": "node scripts/kill-ports.js --yes",
        "install-all": "npm install --prefix backend && npm install --prefix frontend"
    },
    "devDependencies": {
        "playwright": "^1.58.2"
    }
}
