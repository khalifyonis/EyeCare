// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Roles & Security ──

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // SUPERADMIN, ADMIN, DOCTOR, RECEPTIONIST, OPTICIAN, PHARMACIST
  description String?
  users       User[]

  @@map("roles")
}

// ── Core Tables ──

model Branch {
  id         String   @id @default(uuid())
  branchName String   @map("branch_name")
  address    String
  phone      String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relationships
  users                User[]
  staffAssignments     StaffAssignment[]
  doctors              Doctor[]
  patients             Patient[]
  appointments         Appointment[]
  eyeExaminations      EyeExamination[]
  surgeries            Surgery[]
  prescriptions        Prescription[]
  opticalPrescriptions OpticalPrescription[]
  pharmacyItems        PharmacyItem[]
  pharmacyTransactions PharmacyStockTransaction[]
  opticalItems         OpticalItem[]
  opticalTransactions  OpticalStockTransaction[]
  billings             Billing[]
  followUps            FollowUp[]
  suppliers            Supplier[]
  activityLogs         ActivityLog[]

  @@map("clinic_branch")
}

model Supplier {
  id            String         @id @default(uuid())
  branchId      String         @map("branch_id")
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  pharmacyItems PharmacyItem[]
  opticalItems  OpticalItem[]

  @@index([branchId])
  @@map("suppliers")
}

model User {
  id               String    @id @default(uuid())
  fullName         String    @map("full_name")
  username         String    @unique
  email            String    @unique
  password         String
  phone            String?
  resetToken       String?   @unique @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  profileImage     String?   @map("profile_image")
  isActive         Boolean   @default(true) @map("is_active")

  // Multi-tenancy & Governance
  roleId   String @map("role_id")
  role     Role   @relation(fields: [roleId], references: [id])
  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  doctor                      Doctor?
  createdAppointments         Appointment[]              @relation("CreatedBy")
  recordedERExams             ERExamination[]            @relation("RecordedBy")
  pharmacyTransactions        PharmacyStockTransaction[] @relation("PerformedBy")
  opticalTransactions         OpticalStockTransaction[]  @relation("PerformedBy")
  createdBillings             Billing[]                  @relation("CreatedBy")
  staffAssignments            StaffAssignment[]
  activityLogs                ActivityLog[]
  createdOpticalPrescriptions OpticalPrescription[]      @relation("OpticalPrescriptionCreatedBy")

  @@index([branchId])
  @@index([roleId])
  @@map("users")
}

model ActivityLog {
  id         String   @id @default(uuid())
  branchId   String   @map("branch_id")
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String // LOGIN, CREATED, UPDATED, DELETED
  entityType String   @map("entity_type") // Billing, Patient, User, etc.
  entityId   String?  @map("entity_id")
  details    String? // optional JSON or summary
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
  @@index([entityType])
  @@map("activity_logs")
}

model Doctor {
  id             String  @id @default(uuid())
  userId         String  @unique @map("user_id")
  user           User    @relation(fields: [userId], references: [id])
  licenseNumber  String  @unique @map("license_number")
  specialization String
  phone          String?

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  appointments          Appointment[]
  eyeExaminations       EyeExamination[]
  examinedClinicalExams ClinicalExamination[] @relation("ExaminedBy")
  surgeries             Surgery[]             @relation("Surgeon")
  assignedPatients      Patient[]             @relation("AssignedDoctor")

  @@map("doctors")
}

// ── Patient CRM ──

model Patient {
  id            String  @id @default(uuid())
  patientNumber String? @unique @map("patient_number") // PAT-XXXXX format

  // Name (fullName kept for backward compat, firstName/lastName for new wizard)
  fullName  String  @map("full_name")
  firstName String? @map("first_name")
  lastName  String? @map("last_name")

  gender      String?
  dateOfBirth DateTime @map("date_of_birth")
  phone       String   @unique
  email       String?

  // Address (address kept for backward compat, structured fields for new wizard)
  address String?
  city    String?
  state   String?
  zipCode String? @map("zip_code")

  // Medical info
  bloodGroup           String?  @map("blood_group")
  weight               Decimal? @db.Decimal(5, 2)
  allergies            String?
  chiefComplaint       String?  @map("chief_complaint")
  currentMedications   String?  @map("current_medications")
  medicalHistory       String?  @map("medical_history")
  familyMedicalHistory String?  @map("family_medical_history")

  // Emergency contact
  emergencyContactName         String? @map("emergency_contact_name")
  emergencyContactRelationship String? @map("emergency_contact_relationship")
  emergencyContactPhone        String? @map("emergency_contact_phone")

  // Status & assigned doctor
  isActive         Boolean @default(true) @map("is_active")
  assignedDoctorId String? @map("assigned_doctor_id")
  assignedDoctor   Doctor? @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id])

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  appointments         Appointment[]
  surgeries            Surgery[]
  eyeExaminations      EyeExamination[]
  opticalPrescriptions OpticalPrescription[]
  billings             Billing[]
  followUps            FollowUp[]

  @@index([branchId])
  @@index([fullName])
  @@index([phone])
  @@index([isActive])
  @@map("patients")
}

enum OpticalPrescriptionType {
  SPECTACLES
  CONTACT_LENS
  BOTH
}

enum OpticalPrescriptionStatus {
  FILLED
  DISPENSED
}

model OpticalPrescription {
  id String @id @default(uuid())

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  patientId String  @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id])

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("OpticalPrescriptionCreatedBy", fields: [createdById], references: [id])

  type   OpticalPrescriptionType   @default(SPECTACLES)
  status OpticalPrescriptionStatus @default(FILLED)

  validityMonths Int       @default(12) @map("validity_months")
  expiryDate     DateTime  @map("expiry_date")
  dispensedAt    DateTime? @map("dispensed_at")

  notes String?

  // Refraction OD
  odSphere   String? @map("od_sphere")
  odCylinder String? @map("od_cylinder")
  odAxis     Int?    @map("od_axis")
  odAdd      String? @map("od_add")
  odPd       Int?    @map("od_pd")
  odPrism    String? @map("od_prism")

  // Refraction OS
  osSphere   String? @map("os_sphere")
  osCylinder String? @map("os_cylinder")
  osAxis     Int?    @map("os_axis")
  osAdd      String? @map("os_add")
  osPd       Int?    @map("os_pd")
  osPrism    String? @map("os_prism")

  // Spectacle details
  lensType     String?  @map("lens_type")
  lensMaterial String?  @map("lens_material")
  frameType    String?  @map("frame_type")
  coatings     String[] @default([]) @map("coatings")

  // Inventory selections (optional)
  frameItemId String?      @map("frame_item_id")
  frameItem   OpticalItem? @relation("OpticalPrescriptionFrameItem", fields: [frameItemId], references: [id])
  lensItemId  String?      @map("lens_item_id")
  lensItem    OpticalItem? @relation("OpticalPrescriptionLensItem", fields: [lensItemId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([branchId])
  @@index([patientId])
  @@index([type])
  @@index([status])
  @@index([expiryDate])
  @@index([frameItemId])
  @@index([lensItemId])
  @@map("optical_prescriptions")
}

// ── Clinical Tables ──

enum AppointmentStatus {
  PENDING
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Appointment {
  id              String            @id @default(uuid())
  bookingNumber   String?           @unique @map("booking_number")
  appointmentDate DateTime          @map("appointment_date")
  status          AppointmentStatus @default(PENDING)
  amount          Decimal           @default(0) @db.Decimal(10, 2)
  type            String?           @default("consultation")
  notes           String?
  location        String?

  branchId  String  @map("branch_id")
  branch    Branch  @relation(fields: [branchId], references: [id])
  patientId String  @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id])
  doctorId  String  @map("doctor_id")
  doctor    Doctor  @relation(fields: [doctorId], references: [id])

  createdById String @map("created_by")
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  erExamination       ERExamination?
  clinicalExamination ClinicalExamination?
  prescriptions       Prescription[]
  billings            Billing[]
  completedFollowUps  FollowUp[]           @relation("FollowUpCompletedBy")

  @@index([branchId])
  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
  @@map("appointments")
}

model EyeExamination {
  id String @id @default(uuid())

  // Multi-tenancy
  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  patientId String  @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String @map("doctor_id")
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  // Basic
  chiefComplaint          String  @map("chief_complaint")
  historyOfPresentIllness String? @map("history_of_present_illness")

  // Visual acuity
  vaScale         String  @default("SNELLEN") @map("va_scale")
  vaUnaidedOD     String? @map("va_unaided_od")
  vaUnaidedOS     String? @map("va_unaided_os")
  vaUnaidedNearOD String? @map("va_unaided_near_od")
  vaUnaidedNearOS String? @map("va_unaided_near_os")
  vaBcvaOD        String? @map("va_bcva_od")
  vaBcvaOS        String? @map("va_bcva_os")
  vaBcvaNearOD    String? @map("va_bcva_near_od")
  vaBcvaNearOS    String? @map("va_bcva_near_os")
  vaPinholeOD     String? @map("va_pinhole_od")
  vaPinholeOS     String? @map("va_pinhole_os")

  // Refraction
  refractionSphereOD   String? @map("refraction_sphere_od")
  refractionSphereOS   String? @map("refraction_sphere_os")
  refractionCylinderOD String? @map("refraction_cylinder_od")
  refractionCylinderOS String? @map("refraction_cylinder_os")
  refractionAxisOD     String? @map("refraction_axis_od")
  refractionAxisOS     String? @map("refraction_axis_os")

  // IOP
  iopOD       Int?    @map("iop_od")
  iopOS       Int?    @map("iop_os")
  iopMethod   String? @map("iop_method")
  iopTime     String? @map("iop_time")
  targetIopOD Int?    @map("target_iop_od")
  targetIopOS Int?    @map("target_iop_os")

  // Findings
  anteriorSegmentFindings Json? @map("anterior_segment_findings")
  fundusFindings          Json? @map("fundus_findings")

  // Assessment
  diagnosis       String?   @map("diagnosis")
  plan            String?   @map("plan")
  followUpDate    DateTime? @map("follow_up_date")
  nextVisitReason String?   @map("next_visit_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([branchId])
  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt])
  @@map("eye_examinations")
}

model ERExamination {
  id            String      @id @default(uuid())
  appointmentId String      @unique @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  vaRight  String?  @map("va_right")
  vaLeft   String?  @map("va_left")
  phRight  String?  @map("ph_right")
  phLeft   String?  @map("ph_left")
  iopRight Decimal? @map("iop_right") @db.Decimal(10, 2)
  iopLeft  Decimal? @map("iop_left") @db.Decimal(10, 2)
  notes    String?

  recordedById String @map("recorded_by")
  recordedBy   User   @relation("RecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now()) @map("recorded_at")

  @@map("er_examinations")
}

model ClinicalExamination {
  id            String      @id @default(uuid())
  appointmentId String      @unique @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  sphRight  Decimal? @map("sph_right") @db.Decimal(10, 2)
  cylRight  Decimal? @map("cyl_right") @db.Decimal(10, 2)
  axisRight Int?     @map("axis_right")
  sphLeft   Decimal? @map("sph_left") @db.Decimal(10, 2)
  cylLeft   Decimal? @map("cyl_left") @db.Decimal(10, 2)
  axisLeft  Int?     @map("axis_left")

  diagnosis        String?
  managementPlan   String?   @map("management_plan")
  nextReviewDate   DateTime? @map("next_review_date")
  nextReviewReason String?   @map("next_review_reason")

  examinedById String @map("examined_by")
  examinedBy   Doctor @relation("ExaminedBy", fields: [examinedById], references: [id])

  examinedAt DateTime @default(now()) @map("examined_at")

  // Relationships
  surgery       Surgery?
  prescriptions Prescription[]
  followUps     FollowUp[]     @relation("FollowUpFromExam")

  @@map("clinical_examinations")
}

model Surgery {
  id           String               @id @default(uuid())
  // Optional link to a clinical exam (legacy flow). Unique when present.
  examId       String?              @unique @map("exam_id")
  clinicalExam ClinicalExamination? @relation(fields: [examId], references: [id])

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  // Patient-based scheduling (EyeCare Pro module)
  patientId String  @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id])

  eye              String    @map("eye_side") // OD, OS, BOTH (legacy values RIGHT/LEFT still possible)
  surgeryType      String    @map("surgery_type")
  procedure        String?   @map("procedure")
  anesthesiaType   String?   @map("anesthesia_type") // Topical, Local, General
  date             DateTime  @map("surgery_date")
  time             String?   @map("surgery_time") // HH:mm
  operatingRoom    String?   @map("operating_room")
  cataractDetails  Json?     @map("cataract_details") // JSONB (technique, iolModel, iolPower, targetRefraction)
  cost             Decimal   @default(0) @db.Decimal(10, 2)
  status           String    @default("scheduled")
  notes            String?
  nextFollowUpDate DateTime? @map("next_follow_up_date")

  surgeonId String @map("surgeon_id")
  surgeon   Doctor @relation("Surgeon", fields: [surgeonId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  billings  Billing[]
  followUps FollowUp[] @relation("FollowUpFromSurgery")

  @@index([branchId])
  @@index([patientId])
  @@index([surgeonId])
  @@index([status])
  @@map("surgeries")
}

model Prescription {
  id            String              @id @default(uuid())
  appointmentId String              @map("appointment_id")
  appointment   Appointment         @relation(fields: [appointmentId], references: [id])
  examId        String              @map("exam_id")
  clinicalExam  ClinicalExamination @relation(fields: [examId], references: [id])

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  itemType        String  @map("item_type") // PHARMACY, OPTICAL
  itemId          String? @map("item_id")
  quantity        Int
  instructions    String?
  reviewAfterDays Int?    @map("review_after_days")

  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  billings  Billing[]
  followUps FollowUp[] @relation("FollowUpFromPrescription")

  @@index([branchId])
  @@index([appointmentId])
  @@index([examId])
  @@index([itemType])
  @@map("prescriptions")
}

// ── Inventory Tables ──

model PharmacyItem {
  id         String    @id @default(uuid())
  branchId   String    @map("branch_id")
  branch     Branch    @relation(fields: [branchId], references: [id])
  supplierId String?   @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  itemName      String    @map("item_name")
  itemType      String?   @map("item_type") // Tablet, Syrup, etc.
  category      String? // Antibiotic, Painkiller, etc.
  manufacturer  String? // Cidda samaysay
  supplierName  String?   @map("supplier_name") // denormalized for display
  batchNumber   String?   @map("batch_number")
  stockQuantity Int       @default(0) @map("stock_quantity")
  reorderLevel  Int       @default(10) @map("reorder_level")
  purchasePrice Decimal   @map("purchase_price") @db.Decimal(10, 2)
  sellingPrice  Decimal   @map("selling_price") @db.Decimal(10, 2)
  expiryDate    DateTime? @map("expiry_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  isActive Boolean @default(true) @map("is_active")

  // Relationships
  transactions PharmacyStockTransaction[]

  @@unique([branchId, itemName, batchNumber])
  @@index([branchId])
  @@index([supplierId])
  @@index([category])
  @@index([expiryDate])
  @@map("pharmacy_items")
}

model PharmacyStockTransaction {
  id             String       @id @default(uuid())
  pharmacyItemId String       @map("pharmacy_item_id")
  pharmacyItem   PharmacyItem @relation(fields: [pharmacyItemId], references: [id])
  branchId       String       @map("branch_id")
  branch         Branch       @relation(fields: [branchId], references: [id])

  transactionType String  @map("transaction_type") // IN, OUT, ADJUST
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)

  billingId String?  @map("billing_id")
  billing   Billing? @relation(fields: [billingId], references: [id])

  performedById String @map("performed_by")
  performedBy   User   @relation("PerformedBy", fields: [performedById], references: [id])

  transactionDate DateTime @default(now()) @map("transaction_date")

  @@index([pharmacyItemId])
  @@index([branchId])
  @@index([transactionDate])
  @@map("pharmacy_stock_transactions")
}

model OpticalItem {
  id         String    @id @default(uuid())
  branchId   String    @map("branch_id")
  branch     Branch    @relation(fields: [branchId], references: [id])
  supplierId String?   @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  itemName      String  @map("item_name")
  itemType      String? @map("item_type") // Frame, Lens, Solution
  brand         String?
  manufacturer  String? // Cidda samaysay
  supplierName  String? @map("supplier_name") // denormalized for display
  stockQuantity Int     @default(0) @map("stock_quantity")
  reorderLevel  Int     @default(5) @map("reorder_level")
  purchasePrice Decimal @map("purchase_price") @db.Decimal(10, 2)
  sellingPrice  Decimal @map("selling_price") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  isActive Boolean @default(true) @map("is_active")

  // Relationships
  transactions       OpticalStockTransaction[]
  framePrescriptions OpticalPrescription[]     @relation("OpticalPrescriptionFrameItem")
  lensPrescriptions  OpticalPrescription[]     @relation("OpticalPrescriptionLensItem")

  @@unique([branchId, itemName, brand])
  @@index([branchId])
  @@index([supplierId])
  @@map("optical_items")
}

model OpticalStockTransaction {
  id            String      @id @default(uuid())
  opticalItemId String      @map("optical_item_id")
  opticalItem   OpticalItem @relation(fields: [opticalItemId], references: [id])
  branchId      String      @map("branch_id")
  branch        Branch      @relation(fields: [branchId], references: [id])

  transactionType String  @map("transaction_type")
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)

  billingId String?  @map("billing_id")
  billing   Billing? @relation(fields: [billingId], references: [id])

  performedById String @map("performed_by")
  performedBy   User   @relation("PerformedBy", fields: [performedById], references: [id])

  transactionDate DateTime @default(now()) @map("transaction_date")

  @@index([opticalItemId])
  @@index([branchId])
  @@index([transactionDate])
  @@map("optical_stock_transactions")
}

// ── Billing Module ──

enum ServiceType {
  APPOINTMENT
  PHARMACY
  OPTICAL
  SURGERY
}

enum BillingStatus {
  PAID
  UNPAID
  PARTIAL
}

model Billing {
  id        String  @id @default(uuid())
  patientId String  @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id])
  branchId  String  @map("branch_id")
  branch    Branch  @relation(fields: [branchId], references: [id])

  appointmentId  String?       @map("appointment_id")
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  surgeryId      String?       @map("surgery_id")
  surgery        Surgery?      @relation(fields: [surgeryId], references: [id])
  prescriptionId String?       @map("prescription_id")
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  serviceType ServiceType @map("service_type")
  totalAmount Decimal     @map("total_amount") @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  finalAmount Decimal     @map("final_amount") @db.Decimal(10, 2)

  paymentMethod   String?       @map("payment_method")
  referenceNumber String?       @map("reference_number")
  status          BillingStatus @default(UNPAID)

  createdById String @map("created_by")
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Reverse relationships for inventory tracking
  pharmacyTransactions PharmacyStockTransaction[]
  opticalTransactions  OpticalStockTransaction[]

  @@index([branchId])
  @@index([patientId])
  @@index([status])
  @@index([serviceType])
  @@index([createdAt])
  @@map("billing")
}

// ── Follow-ups ──

enum FollowUpSourceType {
  EXAMINATION
  PRESCRIPTION
  SURGERY
  OPTICAL
}

enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
  OVERDUE
}

model FollowUp {
  id        String  @id @default(uuid())
  patientId String  @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId  String  @map("branch_id")
  branch    Branch  @relation(fields: [branchId], references: [id])

  sourceType             FollowUpSourceType @map("source_type")
  sourceId               String             @map("source_id")
  dueDate                DateTime           @map("due_date")
  status                 FollowUpStatus     @default(PENDING)
  notes                  String?
  completedAppointmentId String?            @map("completed_appointment_id")
  completedAppointment   Appointment?       @relation("FollowUpCompletedBy", fields: [completedAppointmentId], references: [id], onDelete: SetNull)

  clinicalExaminationId String?              @map("clinical_examination_id")
  clinicalExamination   ClinicalExamination? @relation("FollowUpFromExam", fields: [clinicalExaminationId], references: [id], onDelete: SetNull)
  surgeryId             String?              @map("surgery_id")
  surgery               Surgery?             @relation("FollowUpFromSurgery", fields: [surgeryId], references: [id], onDelete: SetNull)
  prescriptionId        String?              @map("prescription_id")
  prescription          Prescription?        @relation("FollowUpFromPrescription", fields: [prescriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([branchId])
  @@index([dueDate])
  @@index([status])
  @@map("follow_ups")
}

// ── Staff Assignment (Multi-Branch) ──

model StaffAssignment {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId   String   @map("branch_id")
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isPrimary  Boolean? @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([userId, branchId])
  @@map("staff_assignments")
}
